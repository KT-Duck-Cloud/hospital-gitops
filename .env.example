# docker-compose.yml 용 환경변수 목록. 값은 비워 둔다 (이 파일은 Git 에 올린다).
# scripts/make_env.ps1 이 이 파일을 읽어 빈 비밀번호·키에 무작위 값을 넣은 .env 를 만든다. .env 는 Git 에 올리지 않는다.

# MySQL 관리자 (로컬 컨테이너 초기화용)
MYSQL_ROOT_PASSWORD=

# DB 계정 비밀번호 (db/grants.sql). docker-compose.yml 이 서비스마다 DB_USERNAME·DB_PASSWORD 로 넘긴다.
#   auth·reservation: DB_USERNAME=app_runtime,  DB_PASSWORD=APP_RUNTIME_PASSWORD
#   stats           : DB_USERNAME=app_readonly, DB_PASSWORD=APP_READONLY_PASSWORD
# DB 주소(DB_URL=mysql://mysql:3306/hospital, 계정 없음)는 docker-compose.yml 에 있다. 예전 DATABASE_URL 은 쓰지 않는다.
APP_RUNTIME_PASSWORD=
APP_READONLY_PASSWORD=
APP_MIGRATE_PASSWORD=

# JWT 서명 키 (세 서비스 동일)
JWT_SECRET=

# 진료기록 암호화 키 (AES-256, base64 32바이트). 예약 서비스와 scripts/seed_records.py 가 쓴다.
MEDICAL_KEY=
# 키 버전 (값이 있어서 make_env.ps1 이 바꾸지 않는다)
MEDICAL_KEY_VERSION=1
